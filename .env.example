NODE_ENV=development
PORT=5000
MONGO_URI=xxxx
JWT_SECRET=xxxx
JWT_EXPIRES_IN=1d
# Admin → Auto-Login (impersonation). Tokens carry an `act` claim with the
# admin's id; the handoff to the new tab uses a one-time code (not the JWT).
IMPERSONATION_TOKEN_EXPIRES_IN=1h
IMPERSONATION_CODE_TTL_SECONDS=120

# Password reset flow
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
PASSWORD_RESET_RATE_WINDOW_MINUTES=60
PASSWORD_RESET_RATE_MAX=3

# Frontend origin(s) allowed by CORS. Single origin or comma-separated list.
# REQUIRED in production. In dev, defaults to http://localhost:8080.
# Examples:
#   CLIENT_ORIGIN=http://localhost:8080
#   CLIENT_ORIGIN=https://portal.example.com,https://staff.example.com
CLIENT_ORIGIN=http://localhost:8080

# KYC uploads (GridFS). Default 3145728 (3 MiB). Keep small on free Atlas tiers.
# KYC_MAX_FILE_BYTES=3145728

# Commission (INR) added on top of the live USD->INR reference rate shown on the
# deposit page. Default 2. Raise/lower to change the fee without a code change.
# USD_INR_MARKUP=2

# From/sender address for outgoing mail. Needed when the SMTP auth login is not
# a valid sender (e.g. Brevo's b8...@smtp-brevo.com) — set this to a sender you
# have VERIFIED with your provider. Accepts a bare address or "Name <email>".
# If unset, the SMTP username is used (fine for Hostinger, where they match).
# MAIL_FROM=Equiti Capitals <info@equiticapitals.com>

# MT5: set MT5_AUTOMATION_ENABLED=false when you provision MT5 manually (no bridge API).
# MT5_SUPPORT_EMAIL is optional: if unset, the app uses the SMTP "username" from Admin → SMTP Settings.
MT5_AUTOMATION_ENABLED=false
MT5_SUPPORT_EMAIL=

# Email content is only from Admin → Email Templates. Run: npm run seed:emailers

# SMTP/IMAP credentials, consumed only by `npm run seed:smtp` (which writes them
# into the SmtpConfig document). The running app reads SMTP from the DB, not
# from env — these are just the seed input, equivalent to typing them into
# Admin → SMTP Settings. Defaults below are Hostinger's.
SMTP_USERNAME=xxxx
SMTP_PASSWORD=xxxx
SMTP_SERVER=smtp.hostinger.com
SMTP_PORT=465
SMTP_SSL=true
# Sent-mail archiving via IMAP. Set IMAP_HOST= (empty) to disable.
IMAP_HOST=imap.hostinger.com
IMAP_PORT=993
IMAP_SECURE=true
# Blank auto-detects the \Sent special-use folder.
IMAP_SENT_MAILBOX=

# Required only when MT5_AUTOMATION_ENABLED=true (default)
MT5_SERVICE_BASE_URL=http://localhost:8001
MT5_SERVICE_API_KEY=xxxx
MT5_LOGIN=xxxx
MT5_PASSWORD=xxxx
MT5_SERVER=xxxx